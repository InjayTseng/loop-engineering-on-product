# loop.config.env — one file binds the generic loop to YOUR product.
# Sourced by scripts/run-loop.sh; read by the agent at the top of every round.
# Copy, fill, commit. Everything the gates "measure" is defined here — and the loop
# will maximize exactly what you measure (see docs/06-lessons.md, lesson 1).

# === identity ===
PRODUCT="<one-line product description>"
POSITIONING="product/positioning.md"   # node P authority (hard fields human-only)
STATE="product/state.md"               # node C output, rewritten by state-auditor
DEPLOY_BRANCH="main"        # = live. The loop NEVER runs on or pushes to this branch.
LOOP_BRANCH="loop"          # the loop only ever commits/pushes here.

# === north star (what the value gate judges against) ===
NORTH_STAR="<the funnel or single metric the loop is supposed to move>"
FUNNEL="landing,activation,core_value,depth,share,pay"   # ordered stages; each round names one
CATEGORIES="acquisition,activation,engagement,virality,monetization,retention,trust-quality"
TRUST_PRODUCT="true"        # true = fabricated data (fake counts/popularity/testimonials) is auto-REJECT

# === value gate threshold (value-critic) ===
ACCEPT_IF="impact>=4 AND novelty>=3 AND effort_fit>=3"

# === termination (driver) ===
ROUNDS="20"                 # hard cap per run
WINDOW="5"                  # rolling window for the rejection-rate plateau
PLATEAU_REJ="2"             # stop when  PLATEAU_REJ*rejects >= PLATEAU_SHIP*ships  over WINDOW
PLATEAU_SHIP="3"            #   (2/3 => rejection rate ~0.6)
MAX_CONSEC_REJECTED="2"     # a RESET round that is also fully rejected = genuine exhaustion
MAX_NOOP="3"                # consecutive build/validate failures = something structural, stop
MAX_CONSEC_MAINT="3"        # consecutive maintenance-only rounds = research is dry → hand to P
ROUND_TIMEOUT="1800"        # seconds; a hung round is killed and counted as NOOP
TRAJ_EVERY="5"              # independent trajectory check every N rounds
AUDIT_EVERY="5"             # deep current-state audit (state-auditor) every K rounds; also at run start
AUTONOMOUS_POSITIONING="false"   # true = on STOP/plateau let strategist+critic re-aim soft fields (no human)
MAX_AUTO_POSITIONING="1"    # at most this many autonomous re-aims per run, then exit for a human

# === model routing (cost) ===
LOOP_MODEL="sonnet"                  # orchestrator+builder per round; alias, not a dated id (override: LOOP_MODEL=... scripts/run-loop.sh)
POSITIONING_MODEL="opus"             # the /position autonomous pair runs on a senior model
# value-critic / validator / trajectory-monitor pin their own model in .claude/agents/*.md frontmatter.

# === adapter (how the product is built, observed, and judged broken) ===
# The validator agent runs BUILD_CMD; it must exit 0 on OK and print a JSON {ok:...} or a log.
BUILD_CMD="node scripts/adapters/web-check.mjs /tmp/loop-shot.png"
OBSERVE="screenshot at /tmp/loop-shot.png"
BROKEN_SIGNAL="non-zero exit, page/JS error, or a funnel-critical element missing"
# web adapter: comma-separated strings that MUST be present in the rendered page
WEB_MUST_INCLUDE="<brand string>,<primary CTA label>"
WEB_URL=""                  # empty = file://$PWD/index.html
# ios adapter (uncomment to use scripts/adapters/ios-shot.sh instead)
# BUILD_CMD="scripts/adapters/ios-shot.sh /tmp/loop-shot.png"
# IOS_PROJECT="App.xcodeproj"; IOS_SCHEME="App"; IOS_BUNDLE_ID="com.example.app"; IOS_SIM="iPhone 16 Pro"

# === spec files (usually leave as-is) ===
LOOP_SPEC=".claude/tasks/innovation_loop.md"
LEDGER=".claude/tasks/_idea_ledger.md"
BACKLOG=".claude/tasks/_product_backlog.md"
