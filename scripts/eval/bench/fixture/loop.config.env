# Bench product config — a fixture for scripts/eval/bench.mjs, not a real product.
PRODUCT="Tally: one small habit a day"
POSITIONING="product/positioning.md"
STATE="product/state.md"
DEPLOY_BRANCH="main"
LOOP_BRANCH="loop"
NORTH_STAR="share of new visitors who complete a first check-in within 24 hours"
FUNNEL="landing,activation_done,habit_added,core_value,share,pay"
CATEGORIES="acquisition,activation,engagement,virality,monetization,retention,trust-quality"
TRUST_PRODUCT="true"
ACCEPT_IF="impact>=4 AND novelty>=3 AND effort_fit>=3"
BUILD_CMD="node check.mjs"
OBSERVE="the JSON check.mjs prints: whether the script parses, missing funnel strings, every button with its label and handler code (no browser)"
BROKEN_SIGNAL="non-zero exit, a script syntax error, or a missing funnel-critical string"
